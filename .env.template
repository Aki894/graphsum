# GraphSum 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ===== 通用配置 =====
# 默认使用的 API provider（对应下方 PROVIDER_XXX 的名称，如 siliconflow、deepseek、zhipu 等）
DEFAULT_PROVIDER=cherryin

# 是否在终端显示流式输出
STREAM_TO_TERMINAL=true

# ===== API Provider 配置 =====
# 格式: PROVIDER_{NAME}_API_KEY, PROVIDER_{NAME}_BASE_URL, PROVIDER_{NAME}_MODEL
# 支持任意数量的服务商，只需按格式添加即可
# 所有兼容 OpenAI API 格式的服务商都可以使用

# ----- 硅基流动 SiliconFlow -----
PROVIDER_SILICONFLOW_API_KEY=your-siliconflow-api-key
PROVIDER_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
PROVIDER_SILICONFLOW_MODEL=Pro/deepseek-ai/DeepSeek-V3

# ----- DeepSeek -----
PROVIDER_DEEPSEEK_API_KEY=your-deepseek-api-key
PROVIDER_DEEPSEEK_BASE_URL=http://10.128.2.157:30000/v1
PROVIDER_DEEPSEEK_MODEL=deepseek-chat

# ----- 智谱 AI -----
# PROVIDER_ZHIPU_API_KEY=your-zhipu-api-key
# PROVIDER_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# PROVIDER_ZHIPU_MODEL=glm-4

# ----- 月之暗面 Moonshot -----
# PROVIDER_MOONSHOT_API_KEY=your-moonshot-api-key
# PROVIDER_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# PROVIDER_MOONSHOT_MODEL=moonshot-v1-8k

# ----- 阿里通义 DashScope -----
# PROVIDER_DASHSCOPE_API_KEY=your-dashscope-api-key
# PROVIDER_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PROVIDER_DASHSCOPE_MODEL=qwen-turbo

# ----- OpenAI 官方 -----
# PROVIDER_OPENAI_API_KEY=your-openai-api-key
# PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# PROVIDER_OPENAI_MODEL=gpt-4o

# ===== Reranker 预处理配置 =====
# 用于直播字幕等噪声较多的内容，在送给LLM前先筛选高质量句子
# 是否启用 Reranker 预处理（true/false）
ENABLE_RERANKER_PREPROCESS=false

# Reranker API 配置
# CherryIn bge-reranker (免费，使用 /v1/rerank 端点)
RERANKER_API_KEY=你的cherryin_api_key
RERANKER_BASE_URL=https://open.cherryin.net/v1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3(free)

# 保留得分最高的句子比例（0.0-1.0），如 0.8 表示保留前80%
RERANKER_TOP_RATIO=0.8

# ===== 图谱节点数量上限配置 =====
# 默认的各层节点数量上限
DEFAULT_MAX_LEVEL2_NODES=8
DEFAULT_MAX_LEVEL3_NODES=20
DEFAULT_MAX_LEVEL4_NODES=30

# ===== 测试文件配置 =====
# 单文档测试时使用的文件路径（相对于项目根目录）
# 留空则自动选择 data 目录中的第一个 .docx 文件
TEST_FILE_PATH=
