# GraphSum 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ===== 通用配置 =====
# 默认使用的 API provider（对应下方 PROVIDER_XXX 的名称）
DEFAULT_PROVIDER=openai

# 是否在终端显示流式输出
STREAM_TO_TERMINAL=true

# Flask session 密钥（可选；不设置时每次启动随机生成）
# SECRET_KEY=your-random-secret-key

# ===== API Provider 配置 =====
# 格式: PROVIDER_{NAME}_API_KEY, PROVIDER_{NAME}_BASE_URL, PROVIDER_{NAME}_MODEL
# 支持任意数量的服务商，只需按格式添加即可
# 所有兼容 OpenAI API 格式的服务商都可以使用（官方或自建网关均可）

# ----- OpenAI（默认示例） -----
PROVIDER_OPENAI_API_KEY=your-openai-api-key
PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_OPENAI_MODEL=gpt-4o-mini

# ----- 其他兼容服务商示例（按需取消注释并改名） -----
# PROVIDER_LOCAL_API_KEY=your-api-key
# PROVIDER_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# PROVIDER_LOCAL_MODEL=your-model-name

# ===== Reranker 预处理配置 =====
# 用于直播字幕等噪声较多的内容，在送给LLM前先筛选高质量句子
# 是否启用 Reranker 预处理（true/false）
ENABLE_RERANKER_PREPROCESS=false

# Reranker API 配置（可选；支持 /rerank 端点或返回 true/false 的 chat completions 模型）
# RERANKER_API_KEY=your-reranker-api-key
# RERANKER_BASE_URL=https://your-reranker-host/v1
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 保留得分最高的句子比例（0.0-1.0），如 0.8 表示保留前80%
RERANKER_TOP_RATIO=0.8

# ===== 图谱节点数量上限配置 =====
# 默认的各层节点数量上限
DEFAULT_MAX_LEVEL2_NODES=8
DEFAULT_MAX_LEVEL3_NODES=20
DEFAULT_MAX_LEVEL4_NODES=30

# ===== 测试文件配置 =====
# 单文档测试时使用的文件路径（相对于项目根目录）
# 留空则自动选择 data 目录中的第一个 .docx 文件
TEST_FILE_PATH=